		{"id":"77d917a528f7c679","type":"text","text":"template typename T\nvoid set_zeros(Massive T m) {\n    for (int i = 0; i < m.size(); ++i) {\n        m.set(i, 0);\n    }\n}\n\nMassive m = {1, 2, 3, 4, 5};\nhistory = history::execute(set_zeros, m)","x":-411,"y":60,"width":423,"height":241},
